<!-- AI Recommendations START -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow h-100">
            <!-- Card header -->
            <div class="card-header border-bottom d-flex justify-content-between align-items-center p-4">
                <h5 class="card-header-title">AI Recommendations for Improvements</h5>
            </div>
            <!-- Card body START -->
            <div class="card-body p-4">
                <div class="row g-4">
                    {% for recommendation in aiRecommendations %}
                        <div class="col-md-6 col-lg-4">
                            <div class="card border h-100">
                                <!-- Card header -->
                                <div class="card-header border-bottom d-flex align-items-center">
                                    <div class="icon-md bg-success bg-opacity-10 rounded-circle text-success me-2">
                                        <i class="fas fa-lightbulb fa-fw"></i>
                                    </div>
                                    <h6 class="card-header-title mb-0">{{ recommendation.title }}</h6>
                                </div>
                                <!-- Card body -->
                                <div class="card-body">
                                    <p class="mb-2">{{ recommendation.description }}</p>
                                    <div class="d-flex align-items-center">
                                        <span class="badge rounded-pill 
                                            {% if recommendation.priority == 'High' %}
                                                bg-danger
                                            {% elseif recommendation.priority == 'Medium' %}
                                                bg-warning
                                            {% else %}
                                                bg-info
                                            {% endif %}
                                        ">Priority: {{ recommendation.priority }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            <!-- Card body END -->
        </div>
    </div>
</div>
<!-- AI Recommendations END -->
