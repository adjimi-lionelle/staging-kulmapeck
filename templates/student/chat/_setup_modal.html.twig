<!-- Setup Modal -->
<div class="modal fade" id="setupModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="setupModalLabel">{% trans %}SETUP_PROFILE_KEY{% endtrans %}</h5>
            </div>
            <div class="modal-body">
                <!-- Class Setup Section -->
                <div id="class-setup-section" class="{% if isProfileComplete %}d-none{% endif %}">
                    <div class="profile-setup-section mb-4">
                        <h6>{% trans %}COMPLETE_YOUR_PROFILE_KEY{% endtrans %}</h6>
                        <p>{% trans %}SELECT_CLASS_DESCRIPTION_KEY{% endtrans %}</p>
                        <form id="setup-form" method="POST" action="{{ path('app_student_chat_update_profile') }}">
                            <div class="mb-3">
                                <label for="classe" class="form-label">{% trans %}SELECT_CLASS_KEY{% endtrans %}</label>
                                <select class="form-select" id="classe" name="classe" required>
                                    <option value="">{% trans %}CHOOSE_CLASS_KEY{% endtrans %}</option>
                                </select>
                                <div class="invalid-feedback">
                                    {% trans %}PLEASE_SELECT_CLASS_KEY{% endtrans %}
                                </div>
                            </div>

                            <div class="mb-3" id="specialization-group" style="display: none;">
                                <label for="specialite" class="form-label">{% trans %}SELECT_YOUR_SPECIALIZATION_KEY{% endtrans %}</label>
                                <select class="form-select" id="specialite" name="specialite">
                                    <option value="">{% trans %}CHOOSE_SPECIALIZATION_KEY{% endtrans %}</option>
                                </select>
                                <div class="invalid-feedback">
                                    {% trans %}PLEASE_SELECT_SPECIALIZATION_KEY{% endtrans %}
                                </div>
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary">{% trans %}SAVE_SETUP_KEY{% endtrans %}</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Premium Setup Section -->
                <div id="premium-setup-section" class="{% if not isProfileComplete %}d-none{% endif %}">
                    {% if not isPremium %}
                    <div class="premium-upgrade-section">
                        <h6>{% trans %}PREMIUM_REQUIRED_KEY{% endtrans %}</h6>
                        <p>{% trans %}PREMIUM_CHAT_DESCRIPTION_KEY{% endtrans %}</p>
                        <div class="text-center mt-3">
                            <a href="{{ path('app_plan') }}" class="btn btn-success">{% trans %}UPGRADE_ACCOUNT_KEY{% endtrans %}</a>
                        </div>
                    </div>
                    {% else %}
                    <div class="setup-complete-section text-center">
                        <div class="mb-3">
                            <i class="fas fa-check-circle text-success fa-3x"></i>
                        </div>
                        <h6>{% trans %}SETUP_COMPLETE_KEY{% endtrans %}</h6>
                        <p>{% trans %}SETUP_COMPLETE_DESCRIPTION_KEY{% endtrans %}</p>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{% trans %}CONTINUE_KEY{% endtrans %}</button>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const setupModal = document.getElementById('setupModal');
    if (!setupModal) return;

    const modal = new bootstrap.Modal(setupModal);
    modal.show();

    const classSetupSection = document.getElementById('class-setup-section');
    const premiumSetupSection = document.getElementById('premium-setup-section');
    
    // Make sure premium section is initially hidden if class setup is shown
    if (!classSetupSection.classList.contains('d-none')) {
        premiumSetupSection.classList.add('d-none');
    }
    
    const classeSelect = document.getElementById('classe');
    const specialiteGroup = document.getElementById('specialization-group');
    const specialiteSelect = document.getElementById('specialite');
    const setupForm = document.getElementById('setup-form');

    // Define the skill level IDs for second cycle classes (2nde to Terminale)
    const secondCycleSkillLevels = [5, 6, 7]; // Adjust based on your database

    // Only initialize class setup if the section is visible
    if (!classSetupSection.classList.contains('d-none')) {
        // Fetch classes from API
        fetch('/api/classes')
            .then(response => response.json())
            .then(data => {
                // Add classes to select dropdown
                data['hydra:member'].forEach(classe => {
                    const option = document.createElement('option');
                    option.value = classe.id;
                    option.textContent = classe.name;
                    option.dataset.skillLevel = classe.skillLevel?.id || null;
                    classeSelect.appendChild(option);
                });
            })
            .catch(error => {
                console.error('Error fetching classes:', error);
            });

        // Fetch specializations from API
        fetch('/api/specialites')
            .then(response => response.json())
            .then(data => {
                // Add specializations to select dropdown
                data['hydra:member'].forEach(specialite => {
                    const option = document.createElement('option');
                    option.value = specialite.id;
                    option.textContent = specialite.name;
                    option.dataset.filiere = specialite.filiere?.id || null;
                    specialiteSelect.appendChild(option);
                });
            })
            .catch(error => {
                console.error('Error fetching specializations:', error);
            });

        // Handle class selection change
        classeSelect.addEventListener('change', function() {
            if (!this.value) {
                specialiteGroup.style.display = 'none';
                specialiteSelect.required = false;
                return;
            }

            const selectedOption = this.options[this.selectedIndex];
            const skillLevelId = parseInt(selectedOption.dataset.skillLevel);
            
            // Show specialization only for second cycle classes (2nde to Terminale)
            if (secondCycleSkillLevels.includes(skillLevelId)) {
                specialiteGroup.style.display = 'block';
                specialiteSelect.required = true;
            } else {
                specialiteGroup.style.display = 'none';
                specialiteSelect.required = false;
                specialiteSelect.value = ''; // Reset selection
            }
        });

        // Form validation and submission
        setupForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            let isValid = true;
            
            // Validate class selection
            if (!classeSelect.value) {
                classeSelect.classList.add('is-invalid');
                isValid = false;
            } else {
                classeSelect.classList.remove('is-invalid');
            }
            
            // Validate specialization if required
            const selectedOption = classeSelect.options[classeSelect.selectedIndex];
            if (selectedOption) {
                const skillLevelId = parseInt(selectedOption.dataset.skillLevel);
                
                if (secondCycleSkillLevels.includes(skillLevelId)) {
                    if (!specialiteSelect.value) {
                        specialiteSelect.classList.add('is-invalid');
                        isValid = false;
                    } else {
                        specialiteSelect.classList.remove('is-invalid');
                    }
                }
            }
            
            if (!isValid) {
                return;
            }

            // Submit the form via AJAX to avoid page reload
            const formData = new FormData(this);
            
            fetch(this.action, {
                method: 'POST',
                body: new URLSearchParams(formData),
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Hide class setup and show premium setup
                    classSetupSection.classList.add('d-none');
                    premiumSetupSection.classList.remove('d-none');
                } else {
                    alert(data.message || '{% trans %}ERROR_UPDATING_PROFILE_KEY{% endtrans %}');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('{% trans %}ERROR_UPDATING_PROFILE_KEY{% endtrans %}');
            });
        });
    }
});
</script>