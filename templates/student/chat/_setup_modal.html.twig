<!-- Setup Modal -->
<div class="modal fade" id="setupModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="setupModalLabel">{% trans %}SETUP_PROFILE{% endtrans %}</h5>
            </div>
            <div class="modal-body">
                <form id="setup-form" method="POST">
                    <div class="mb-3">
                        <label for="classe" class="form-label">{% trans %}SELECT_CLASS{% endtrans %}</label>
                        <select class="form-select" id="classe" name="classe" required>
                            <option value="">{% trans %}CHOOSE_CLASS{% endtrans %}</option>
                        </select>
                        <div class="invalid-feedback">
                            {% trans %}PLEASE_SELECT_CLASS{% endtrans %}
                        </div>
                    </div>

                    <div class="mb-3" id="specialization-group" style="display: none;">
                        <label for="specialite" class="form-label">{% trans %}SELECT_SPECIALIZATION{% endtrans %}</label>
                        <select class="form-select" id="specialite" name="specialite">
                            <option value="">{% trans %}CHOOSE_SPECIALIZATION{% endtrans %}</option>
                        </select>
                        <div class="invalid-feedback">
                            {% trans %}PLEASE_SELECT_SPECIALIZATION{% endtrans %}
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">{% trans %}SAVE{% endtrans %}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const classeSelect = document.getElementById('classe');
    const specialiteGroup = document.getElementById('specialization-group');
    const specialiteSelect = document.getElementById('specialite');
    const setupForm = document.getElementById('setup-form');

    // Define the skill level IDs for second cycle classes (2nde to Terminale)
    const secondCycleSkillLevels = [5, 6, 7]; // Adjust based on your database

    // Fetch classes from API
    fetch('/api/classes')
        .then(response => response.json())
        .then(data => {
            // Add classes to select dropdown
            data['hydra:member'].forEach(classe => {
                const option = document.createElement('option');
                option.value = classe.id;
                option.textContent = classe.name;
                option.dataset.skillLevel = classe.skillLevel?.id || null;
                classeSelect.appendChild(option);
            });
        })
        .catch(error => {
            console.error('Error fetching classes:', error);
        });

    // Fetch specializations from API
    fetch('/api/specialites')
        .then(response => response.json())
        .then(data => {
            // Add specializations to select dropdown
            data['hydra:member'].forEach(specialite => {
                const option = document.createElement('option');
                option.value = specialite.id;
                option.textContent = specialite.name;
                option.dataset.filiere = specialite.filiere?.id || null;
                specialiteSelect.appendChild(option);
            });
        })
        .catch(error => {
            console.error('Error fetching specializations:', error);
        });

    // Handle class selection change
    classeSelect.addEventListener('change', function() {
        if (!this.value) {
            specialiteGroup.style.display = 'none';
            specialiteSelect.required = false;
            return;
        }

        const selectedOption = this.options[this.selectedIndex];
        const skillLevelId = parseInt(selectedOption.dataset.skillLevel);
        
        // Show specialization only for second cycle classes (2nde to Terminale)
        if (secondCycleSkillLevels.includes(skillLevelId)) {
            specialiteGroup.style.display = 'block';
            specialiteSelect.required = true;
        } else {
            specialiteGroup.style.display = 'none';
            specialiteSelect.required = false;
            specialiteSelect.value = ''; // Reset selection
        }
    });

    // Form validation and submission
    setupForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        let isValid = true;
        
        // Validate class selection
        if (!classeSelect.value) {
            classeSelect.classList.add('is-invalid');
            isValid = false;
        } else {
            classeSelect.classList.remove('is-invalid');
        }
        
        // Validate specialization if required
        const selectedOption = classeSelect.options[classeSelect.selectedIndex];
        if (selectedOption) {
            const skillLevelId = parseInt(selectedOption.dataset.skillLevel);
            
            if (secondCycleSkillLevels.includes(skillLevelId)) {
                if (!specialiteSelect.value) {
                    specialiteSelect.classList.add('is-invalid');
                    isValid = false;
                } else {
                    specialiteSelect.classList.remove('is-invalid');
                }
            }
        }
        
        if (!isValid) {
            return;
        }

        // Prepare form data
        const formData = new FormData();
        formData.append('classe', classeSelect.value);
        
        if (specialiteSelect.value) {
            formData.append('specialite', specialiteSelect.value);
        }

        // Submit form data via AJAX
        fetch('{{ path('app_student_profile_edit') }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Network response was not ok');
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                // Close the modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('setupModal'));
                if (modal) {
                    modal.hide();
                }
                
                // Reload the page to reflect changes
                window.location.reload();
            } else {
                alert(data.message || '{% trans %}ERROR_UPDATING_PROFILE{% endtrans %}');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('{% trans %}ERROR_UPDATING_PROFILE{% endtrans %}');
        });
    });
});
</script>
