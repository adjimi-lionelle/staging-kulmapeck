{% extends 'student/chat/base_chat.html.twig' %}

{% block title %}Chat{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/subject_chat.css') }}">
    <link rel="stylesheet" href="{{ asset('css/static_chat_fixes.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
    <div class="chat-app">
        <div class="chat-sidebar">
            <div class="sidebar-header">
                <h5>Messages</h5>
                <button type="button" class="btn btn-icon">
                    <i class="bi bi-pencil-square"></i>
                </button>
            </div>
            <div class="sidebar-search">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="subject-search" class="form-control" placeholder="Search subjects...">
                </div>
            </div>
            <div class="sidebar-content">
                <div id="subject-list" class="chat-list">
                    <!-- Static subject items for UI display -->
                    <div class="chat-item active" data-subject-id="1">
                        <div class="chat-item-avatar">
                            <div class="avatar-placeholder rounded-circle">M</div>
                        </div>
                        <div class="chat-item-info">
                            <div class="chat-item-name">Mathematics</div>
                            <div class="chat-item-preview">Start chatting...</div>
                        </div>
                        <div class="chat-item-meta">
                            <div class="chat-item-time">12:30 PM</div>
                            <div class="chat-item-badge">3</div>
                        </div>
                    </div>
                    <div class="chat-item" data-subject-id="2">
                        <div class="chat-item-avatar">
                            <div class="avatar-placeholder rounded-circle">P</div>
                        </div>
                        <div class="chat-item-info">
                            <div class="chat-item-name">Physics</div>
                            <div class="chat-item-preview">How can I help you today?</div>
                        </div>
                        <div class="chat-item-meta">
                            <div class="chat-item-time">11:45 AM</div>
                        </div>
                    </div>
                    <div class="chat-item" data-subject-id="3">
                        <div class="chat-item-avatar">
                            <div class="avatar-placeholder rounded-circle">C</div>
                        </div>
                        <div class="chat-item-info">
                            <div class="chat-item-name">Chemistry</div>
                            <div class="chat-item-preview">Let's discuss the periodic table</div>
                        </div>
                        <div class="chat-item-meta">
                            <div class="chat-item-time">10:15 AM</div>
                            <div class="chat-item-badge">1</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="chat-content">
            <!-- Welcome screen - initially hidden for demo -->
            <div class="welcome-screen" id="welcome-screen" style="display: none;">
                <div class="welcome-content">
                    <div class="welcome-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>
                    <h3>Welcome to Kulmapeck Chat</h3>
                    <p>Select a subject from the sidebar to start chatting</p>
                </div>
            </div>
            
            <!-- Chat header - visible for demo -->
            <div id="chat-header" class="chat-header">
                <div class="chat-header-info">
                    <div class="chat-header-avatar">
                        <div class="avatar-placeholder rounded-circle">M</div>
                    </div>
                    <div class="chat-header-details">
                        <div class="chat-header-name">Mathematics</div>
                        <div class="chat-header-status">
                            <span class="status-indicator online"></span>
                            <span>online</span>
                        </div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-telephone"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-camera-video"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                </div>
            </div>
            
            <!-- Chat messages - visible for demo -->
            <div id="chat-messages" class="chat-body">
                <div class="message-wrapper">
                    <div class="message-time">Today</div>
                    
                    <!-- Static message examples -->
                    <div class="message-item">
                        <div class="message-avatar">
                            <div class="avatar-placeholder rounded-circle">M</div>
                        </div>
                        <div class="message-content">
                            <div class="message-bubble">
                                <div class="message-text">Hello! I'm your Mathematics teacher. How can I help you today?</div>
                            </div>
                            <div class="message-info">
                                <div class="message-time">10:00 AM</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="message-item outgoing">
                        <div class="message-content">
                            <div class="message-bubble">
                                <div class="message-text">Hi! I'm having trouble with calculus. Can you explain derivatives?</div>
                            </div>
                            <div class="message-info">
                                <div class="message-time">10:05 AM</div>
                                <div class="message-status">
                                    <i class="bi bi-check2-all"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="message-item">
                        <div class="message-avatar">
                            <div class="avatar-placeholder rounded-circle">M</div>
                        </div>
                        <div class="message-content">
                            <div class="message-bubble">
                                <div class="message-text">Of course! A derivative measures the rate at which a function changes at a particular point. It's the slope of the tangent line to the function at that point.</div>
                            </div>
                            <div class="message-info">
                                <div class="message-time">10:10 AM</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Chat input - visible for demo -->
            <div class="chat-footer" id="chat-footer">
                <div class="chat-input-container">
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-emoji-smile"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <div class="input-wrapper">
                        <textarea id="message-input" class="form-control" placeholder="Type a message..."></textarea>
                    </div>
                    <button id="send-message" type="button" class="btn btn-primary">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/static_chat.js') }}"></script>
{% endblock %}
