{% extends 'student/base.html.twig' %}

{% block subTitle %}{% trans %}CHAT_TITLE_KEY{% endtrans %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    {{ encore_entry_link_tags('chat_styles') }}
{% endblock %}

{% block studentContent %}
    {% if needsSetup is defined and needsSetup %}
        {% include 'student/chat/_setup_modal.html.twig' with {
            'classes': classes,
            'specialites': specialites
        } %}
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="text-center my-5">
                            <i class="bi bi-chat-dots-fill" style="font-size: 64px; color: #0d6efd;"></i>
                            <h3 class="mt-4">{% trans %}WELCOME_TO_CHAT_KEY{% endtrans %}</h3>
                            <p class="text-muted">{% trans %}PLEASE_SETUP_PROFILE_KEY{% endtrans %}</p>
                            <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#setup-modal">
                                <i class="bi bi-gear-fill me-2"></i>{% trans %}SETUP_PROFILE{% endtrans %}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="row">
            <div class="col-12">
                <div id="react-chat"
                     data-websocket-url="{{ websocket_url }}"
                     data-token="{{ student_token }}"
                     data-subjects="{{ chats|json_encode|e('html_attr') }}"
                     data-messages="[]">
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('chat') }}
{% endblock %}
