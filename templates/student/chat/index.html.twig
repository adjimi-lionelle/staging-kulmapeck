{% extends 'student/chat/base_chat.html.twig' %}

{% block title %}Chat{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/subject_chat.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
    {% if showSetupModal is defined and showSetupModal %}
        {% include 'student/chat/_setup_modal.html.twig' with {
            'isProfileComplete': isProfileComplete is defined ? isProfileComplete : null,
            'isPremium': isPremium is defined ? isPremium : null
        } %}
    {% endif %}

    <div class="chat-app">
        <div class="chat-sidebar">
            <div class="sidebar-header">
                <h5>Messages</h5>
                <button type="button" class="btn btn-icon">
                    <i class="bi bi-pencil-square"></i>
                </button>
            </div>
            <div class="sidebar-search">
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="subject-search" class="form-control" placeholder="Search subjects...">
                </div>
            </div>
            <div class="sidebar-content">
                <div id="subject-list" class="chat-list">
                    {% if subjects is defined and subjects is not empty %}
                        {% for subject in subjects %}
                            <div class="chat-item{% if loop.first %} active{% endif %}" data-subject-id="{{ subject.id }}">
                                <div class="chat-item-avatar">
                                    {% if subject.icon is defined and subject.icon %}
                                        <img src="{{ asset(subject.icon) }}" alt="{{ subject.name }}" class="rounded-circle">
                                    {% else %}
                                        <div class="avatar-placeholder rounded-circle">
                                            {{ subject.name|first|upper }}
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="chat-item-info">
                                    <div class="chat-item-name">{{ subject.name }}</div>
                                    <div class="chat-item-preview">{{ subject.lastMessage|default('Start chatting...') }}</div>
                                </div>
                                <div class="chat-item-meta">
                                    {% if subject.unreadCount > 0 %}
                                        <div class="chat-item-badge">{{ subject.unreadCount }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="loading-state text-center p-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3 text-muted">Loading subjects...</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="chat-content">
            <button type="button" class="mobile-back-button">
                <i class="bi bi-arrow-left"></i> Back to subjects
            </button>
            <div class="welcome-screen" id="welcome-screen">
                <div class="welcome-content">
                    <div class="welcome-icon">
                        <i class="bi bi-chat-dots"></i>
                    </div>
                    <h3 class="text-center text-dark">Bienvenue sur l'espace de chat Kulmapeck</h3>
                    <p class="text-center text-dark">Sélectionnez un sujet dans la barre latérale pour commencer une discussion</p>
                </div>
            </div>
            <div id="chat-header" class="chat-header" style="display: none;">
                <div class="chat-header-info">
                    <div class="chat-header-avatar">
                        <div class="avatar-placeholder rounded-circle">A</div>
                    </div>
                    <div class="chat-header-details">
                        <div class="chat-header-name">Alice Johnson</div>
                        <div class="chat-header-status">
                            <span class="status-indicator online"></span>
                            <span>online</span>
                        </div>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-telephone"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-camera-video"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                </div>
            </div>
            <div id="chat-messages" class="chat-body" style="display: none;">
                <div class="message-wrapper">
                    <div class="message-time">Today</div>
                    <!-- Messages will be populated by JavaScript -->
                </div>
            </div>
            <div class="chat-footer" style="display: none;" id="chat-footer">
                <div class="chat-input-container">
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-emoji-smile"></i>
                    </button>
                    <button type="button" class="btn btn-icon">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <div class="input-wrapper">
                        <textarea id="message-input" class="form-control" placeholder="Entrez un message..."></textarea>
                    </div>
                    <button id="send-message" type="button" class="btn btn-primary">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/chat.js') }}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const chatApp = document.querySelector('.chat-app');
            const welcomeScreen = document.getElementById('welcome-screen');
            const chatHeader = document.getElementById('chat-header');
            const chatMessages = document.getElementById('chat-messages');
            const chatFooter = document.getElementById('chat-footer');
            const chatItems = document.querySelectorAll('.chat-item');
            const mobileBackButton = document.querySelector('.mobile-back-button');
            
            // Check if we're on mobile
            const isMobile = window.innerWidth <= 768;
            
            // When a subject is clicked
            chatItems.forEach(item => {
                item.addEventListener('click', function() {
                    // Mark this item as active
                    chatItems.forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    
                    // On mobile, show chat view
                    if (isMobile) {
                        chatApp.classList.add('chat-active');
                    }
                    
                    // Hide welcome screen, show chat
                    if (welcomeScreen) welcomeScreen.style.display = 'none';
                    if (chatHeader) chatHeader.style.display = 'flex';
                    if (chatMessages) chatMessages.style.display = 'block';
                    if (chatFooter) chatFooter.style.display = 'flex';
                    
                    // Dispatch event for other components
                    document.dispatchEvent(new CustomEvent('subjectSelected', {
                        detail: { subjectId: this.dataset.subjectId }
                    }));
                });
            });
            
            // Mobile back button
            if (mobileBackButton) {
                mobileBackButton.addEventListener('click', function() {
                    chatApp.classList.remove('chat-active');
                });
            }
            
            // Handle window resize
            window.addEventListener('resize', function() {
                const newIsMobile = window.innerWidth <= 768;
                
                // If switching between mobile and desktop
                if (newIsMobile !== isMobile) {
                    // Reset the view
                    if (!newIsMobile) {
                        chatApp.classList.remove('chat-active');
                    }
                }
            });
        });
    </script>
{% endblock %}
