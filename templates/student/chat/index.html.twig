{% extends "student/base.html.twig" %}

{% block title %} - Chat{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/subject_chat.css') }}">
{% endblock %}

{% block mainContent %}
    {% if needsSetup is defined and needsSetup %}
        {% include 'student/chat/_setup_modal.html.twig' with {
            'classes': classes,
            'specialites': specialites
        } %}
        <div class="chat-container">
            <div class="chat-content">
                <div class="text-center mt-5">
                    <h3>{% trans %}WELCOME_TO_CHAT_KEY{% endtrans %}</h3>
                    <p>{% trans %}PLEASE_SETUP_PROFILE_KEY{% endtrans %}</p>
                </div>
            </div>
        </div>
    {% else %}
        <div class="chat-container">
            {# Sidebar #}
            <div class="chat-sidebar">
                <div class="search-container">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="{% trans %}SEARCH_SUBJECT_KEY{% endtrans %}">
                    </div>
                </div>
                <div class="chat-list">
                    {% if chats is empty %}
                        <div class="chat-item">
                            <div class="chat-item-info">
                                <div class="chat-item-name">{% trans %}NO_SUBJECTS_YET_KEY{% endtrans %}</div>
                            </div>
                        </div>
                    {% else %}
                        {% for chat in chats %}
                            <div class="chat-item" data-subject-id="{{ chat.id }}">
                                <div class="chat-item-avatar">
                                    <i class="bi bi-{{ chat.matiere.icon|default('book') }}"></i>
                                </div>
                                <div class="chat-item-info">
                                    <div class="chat-item-name">{{ chat.matiere.name }}</div>
                                    <div class="chat-item-preview">Prof. {{ chat.teacherName|default('') }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>

            {# Welcome Screen #}
            <div class="chat-content">
                <div class="chat-header">
                    <div class="chat-header-info">
                        <div class="chat-header-name">{% trans %}WELCOME_TO_SUBJECT_CHAT_KEY{% endtrans %}</div>
                        <div class="chat-header-status">
                            <i class="bi bi-circle-fill"></i>
                            <span>{% trans %}SELECT_SUBJECT_TO_START_KEY{% endtrans %}</span>
                        </div>
                    </div>
                </div>
                <div class="chat-messages">
                    <div class="text-center mt-5">
                        <i class="bi bi-chat-dots" style="font-size: 48px; color: #6c757d;"></i>
                        <h4 class="mt-3">{% trans %}SELECT_SUBJECT_TO_START_KEY{% endtrans %}</h4>
                        <p class="text-muted">{% trans %}CLICK_SUBJECT_TO_START_KEY{% endtrans %}</p>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            {% if needsSetup %}
                const setupModal = new bootstrap.Modal(document.getElementById('setup-modal'));
                setupModal.show();
            {% endif %}

            // Handle subject selection
            const subjects = document.querySelectorAll('.chat-item');
            subjects.forEach(subject => {
                subject.addEventListener('click', function() {
                    document.querySelectorAll('.chat-item').forEach(i => i.classList.remove('active'));
                    this.classList.add('active');
                    const subjectId = this.dataset.subjectId;
                    window.location.href = '{{ path("app_subject_chat", {"subject": "__ID__"}) }}'.replace('__ID__', subjectId);
                });
            });

            // Handle search
            const searchInput = document.querySelector('.search-box input');
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase();
                subjects.forEach(item => {
                    const name = item.querySelector('.chat-item-name').textContent.toLowerCase();
                    const teacher = item.querySelector('.chat-item-preview')?.textContent.toLowerCase() || '';
                    const visible = name.includes(query) || teacher.includes(query);
                    item.style.display = visible ? '' : 'none';
                });
            });
        });
    </script>
{% endblock %}
