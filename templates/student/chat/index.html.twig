{% extends 'student/chat/base_chat.html.twig' %}

{% block body %}
    {% if needsSetup is defined and needsSetup %}
        {% include 'student/chat/_setup_modal.html.twig' with {
            'classes': classes,
            'specialites': specialites
        } %}
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="text-center my-5">
                                <i class="bi bi-chat-dots-fill" style="font-size: 64px; color: #0d6efd;"></i>
                                <h3 class="mt-4">{% trans %}WELCOME_TO_CHAT_KEY{% endtrans %}</h3>
                                <p class="text-muted">{% trans %}PLEASE_SETUP_PROFILE_KEY{% endtrans %}</p>
                                <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#setup-modal">
                                    <i class="bi bi-gear-fill me-2"></i>{% trans %}SETUP_PROFILE{% endtrans %}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <div class="chat-container" id="chat-container" 
                                 data-websocket-url="{{ websocket_url }}"
                                 data-token="{{ token }}">
                                
                                <!-- Chat Sidebar -->
                                <div class="chat-sidebar">
                                    <div class="search-container p-3 border-bottom">
                                        <div class="search-box">
                                            <i class="bi bi-search"></i>
                                            <input type="text" id="subject-search" placeholder="{% trans %}SEARCH_SUBJECT_KEY{% endtrans %}" class="form-control">
                                        </div>
                                    </div>
                                    <div class="chat-list" id="subject-list">
                                        {% if subjects is empty %}
                                            <div class="empty-state text-center p-4">
                                                <i class="bi bi-journal-x" style="font-size: 48px; color: #6c757d;"></i>
                                                <p class="mt-3 text-muted">{% trans %}NO_SUBJECTS_YET_KEY{% endtrans %}</p>
                                            </div>
                                        {% else %}
                                            {% for subject in subjects %}
                                                <div class="chat-item" data-subject-id="{{ subject.id }}">
                                                    <div class="chat-item-avatar">
                                                        {% if subject.icon %}
                                                            <img src="{{ asset(subject.icon) }}" alt="{{ subject.name }}" class="rounded-circle">
                                                        {% else %}
                                                            <div class="avatar-placeholder rounded-circle bg-primary text-white">
                                                                <i class="bi bi-book-fill"></i>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="chat-item-info">
                                                        <div class="chat-item-name">{{ subject.name }}</div>
                                                        <div class="chat-item-preview">Prof. {{ subject.teacherName|default('') }}</div>
                                                    </div>
                                                    {% if subject.unreadCount > 0 %}
                                                        <div class="chat-item-badge">{{ subject.unreadCount }}</div>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <!-- Chat Content -->
                                <div class="chat-content">
                                    <!-- Chat Header -->
                                    <div class="chat-header border-bottom" id="chat-header">
                                        <div class="chat-header-info">
                                            <div class="chat-header-name">{% trans %}SELECT_SUBJECT_TO_START_KEY{% endtrans %}</div>
                                            <div class="chat-header-status">
                                                <i class="bi bi-circle-fill text-success"></i>
                                                <span>{% trans %}ONLINE{% endtrans %}</span>
                                            </div>
                                        </div>
                                        <div class="chat-header-actions">
                                            <button type="button" class="btn btn-light btn-sm rounded-circle">
                                                <i class="bi bi-gear"></i>
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <!-- Chat Messages -->
                                    <div class="chat-messages" id="chat-messages">
                                        <div class="welcome-screen text-center" id="welcome-screen">
                                            <i class="bi bi-chat-dots-fill" style="font-size: 64px; color: #0d6efd;"></i>
                                            <h4 class="mt-4">{% trans %}SELECT_SUBJECT_TO_START_KEY{% endtrans %}</h4>
                                            <p class="text-muted">{% trans %}CLICK_SUBJECT_TO_START_KEY{% endtrans %}</p>
                                        </div>
                                        
                                        <div class="message-container" id="message-container" style="display: none;">
                                            <!-- Messages will be loaded here -->
                                        </div>
                                    </div>
                                    
                                    <!-- Chat Input -->
                                    <div class="chat-input-container" id="chat-input-container" style="display: none;">
                                        <div class="typing-indicator" id="typing-indicator" style="display: none;">
                                            <span class="typing-user"></span> {% trans %}IS_TYPING_KEY{% endtrans %}...
                                        </div>
                                        <div class="chat-input">
                                            <textarea id="message-input" class="form-control" placeholder="{% trans %}TYPE_MESSAGE_KEY{% endtrans %}" rows="1"></textarea>
                                            <button id="send-message" class="btn btn-primary rounded-circle">
                                                <i class="bi bi-send-fill"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/subject_chat.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/subject_chat.js') }}"></script>
{% endblock %}
