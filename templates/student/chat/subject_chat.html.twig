{% extends 'student/chat/base_chat.html.twig' %}

{% block chat_list %}
    {% for chat in chats %}
        <div class="chat-item {% if chat.id == currentSubject.id %}active{% endif %}" data-subject-id="{{ chat.id }}">
            <div class="chat-item-avatar">
                {% if chat.matiere.imageFile %}
                    <img src="{{ asset(chat.matiere.imageFile) }}" alt="{{ chat.matiere.name }}">
                {% else %}
                    <i class="bi bi-{{ chat.matiere.icon|default('book') }}"></i>
                {% endif %}
            </div>
            <div class="chat-item-info">
                <div class="chat-item-name">{{ chat.matiere.name }}</div>
                <div class="chat-item-preview">Prof. {{ chat.teacherName|default('') }}</div>
            </div>
        </div>
    {% endfor %}
{% endblock %}

{% block chat_content %}
    <div class="chat-header">
        <div class="chat-header-info">
            <div class="chat-header-avatar">
                {% if currentSubject.matiere.imageFile %}
                    <img src="{{ asset(currentSubject.matiere.imageFile) }}" alt="{{ currentSubject.matiere.name }}">
                {% else %}
                    <i class="bi bi-{{ currentSubject.matiere.icon|default('book') }}"></i>
                {% endif %}
            </div>
            <div>
                <div class="chat-header-name">{{ currentSubject.matiere.name }}</div>
                <div class="chat-header-status">
                    <i class="bi bi-circle-fill text-success"></i>
                    <span>Prof. {{ currentSubject.teacherName|default('') }}</span>
                </div>
            </div>
        </div>
        <div class="chat-header-actions">
            <button class="btn btn-link" title="{% trans %}REFRESH_CHAT_KEY{% endtrans %}">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button class="btn btn-link" title="{% trans %}MORE_OPTIONS_KEY{% endtrans %}">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
        </div>
    </div>

    <div class="chat-messages" id="chat-messages">
        {% for message in messages %}
            <div class="message {% if message.fromStudent %}outgoing{% else %}incoming{% endif %}">
                <div class="message-content">
                    {{ message.content|raw }}
                    {% if message.attachment %}
                        <div class="message-attachment">
                            <i class="bi bi-paperclip"></i>
                            <a href="{{ asset(message.attachment) }}" target="_blank">{{ message.attachmentName }}</a>
                        </div>
                    {% endif %}
                </div>
                <div class="message-info">
                    <span class="message-time">{{ message.createdAt|date('H:i') }}</span>
                    {% if message.fromStudent %}
                        <span class="message-status">
                            <i class="bi bi-check2-all"></i>
                        </span>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="chat-input">
        <div class="input-group">
            <button class="btn btn-link" title="{% trans %}ATTACH_FILE_KEY{% endtrans %}">
                <i class="bi bi-paperclip"></i>
            </button>
            <textarea class="form-control" placeholder="{% trans %}TYPE_MESSAGE_KEY{% endtrans %}" rows="1"></textarea>
            <button class="btn btn-primary send-message">
                <i class="bi bi-send"></i>
            </button>
        </div>
    </div>
{% endblock %}

{% block chat_scripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-resize textarea
            const textarea = document.querySelector('.chat-input textarea');
            textarea.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            });

            // Handle subject selection
            const subjects = document.querySelectorAll('.chat-item');
            subjects.forEach(subject => {
                subject.addEventListener('click', function() {
                    if (!this.classList.contains('active')) {
                        const subjectId = this.dataset.subjectId;
                        window.location.href = '{{ path("app_subject_chat", {"subject": "__ID__"}) }}'.replace('__ID__', subjectId);
                    }
                });
            });

            // Enhanced search with highlighting
            const searchInput = document.querySelector('.search-box input');
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase();
                subjects.forEach(item => {
                    const name = item.querySelector('.chat-item-name').textContent.toLowerCase();
                    const teacher = item.querySelector('.chat-item-preview')?.textContent.toLowerCase() || '';
                    const visible = name.includes(query) || teacher.includes(query);
                    
                    if (visible && query) {
                        const nameEl = item.querySelector('.chat-item-name');
                        const teacherEl = item.querySelector('.chat-item-preview');
                        
                        nameEl.innerHTML = highlightText(nameEl.textContent, query);
                        teacherEl.innerHTML = highlightText(teacherEl.textContent, query);
                    }
                    
                    item.style.display = visible ? '' : 'none';
                });
            });

            function highlightText(text, query) {
                const regex = new RegExp(`(${query})`, 'gi');
                return text.replace(regex, '<mark>$1</mark>');
            }

            // Scroll to bottom of messages
            const messagesContainer = document.getElementById('chat-messages');
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        });
    </script>
{% endblock %}
